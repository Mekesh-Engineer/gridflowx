# ==============================================================================
# GridFlowX Platform Environment Variables Template
# Copy this file to .env and replace placeholders with production/local values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
PROJECT_NAME="GridFlowX Microgrid Management Platform"
API_VERSION=v1
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=3000
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://gridflowx.web.app"

# ------------------------------------------------------------------------------
# 2. Ollama Cloud AI Models & Runtime Configuration
# ------------------------------------------------------------------------------
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_CLOUD_BASE_URL=https://cloud.ollama.ai/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL="gemma4:31b-cloud"
OLLAMA_TIMEOUT_SEC=60.0
OLLAMA_AUTO_START=true

# Primary Cloud-Hosted Agentic AI Models
MODEL_MICRO_FAST="gemma4:31b-cloud"        # Gemma 4 31B Cloud for micro-level control, fast tool calling, anomaly classification
MODEL_MACRO_REASONING="gpt-oss:120b-cloud" # GPT-OSS 120B Cloud for macro-level Pareto optimization, deep reasoning, strategic diagnostics

# AI Runtime & Latency Thresholds
AI_INFERENCE_TIMEOUT_MS=2500               # Max roundtrip timeout before triggering model switching/fallback
AI_MICRO_MAX_TOKENS=1024                   # Token limit for Gemma 4 31B
AI_MACRO_MAX_TOKENS=4096                   # Token limit for GPT-OSS 120B
AI_FALLBACK_ON_ERROR=true                  # Fallback from 120B to 31B on error/rate-limit, then to deterministic heuristics

# ------------------------------------------------------------------------------
# 3. Supabase Cloud Data Platform (PostgreSQL, Auth, Storage, Realtime)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 4. Frontend Application Variables
# ------------------------------------------------------------------------------
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_WS_TELEMETRY_URL=ws://localhost:8000/ws/telemetry
NEXT_PUBLIC_WS_CLIENT_URL=ws://localhost:8000/ws/client
NEXT_PUBLIC_ENABLE_MOCK_HARDWARE=false

# ------------------------------------------------------------------------------
# 5. Edge Hardware & FreeRTOS Dual-Core Safety Loop
# ------------------------------------------------------------------------------
EDGE_DEVICE_ID="GFX-ESP32-MASTER-01"
EDGE_SHARED_SECRET="your_shared_device_secret_here"
DEVICE_WS_TOKEN="your_device_ws_token_here"
DEV_BYPASS_AUTH=true
TELEMETRY_STREAM_HZ=1
CORE0_SAFETY_LOOP_HZ=100
VOLTAGE_CUTOFF_LOW=10.5
VOLTAGE_CUTOFF_HIGH=14.8
CURRENT_LIMIT_MAX=20.0
HEATSINK_TEMP_LIMIT_C=85.0
