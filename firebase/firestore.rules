rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Get user's custom claim role
    function getUserRole() {
      return request.auth.token.role;
    }

    // Helper: Verify if user has one of the specified roles
    function hasRole(allowedRoles) {
      return isAuthenticated() && (getUserRole() in allowedRoles);
    }

    // ── Telemetry Collection ──
    match /telemetry/{document} {
      allow read: if hasRole(['admin', 'supervisor', 'operator', 'auditor']);
      allow write: if false; // Only FastAPI backend writes via Admin SDK
    }

    // ── Relay States Collection ──
    match /relayStates/{document} {
      allow read: if hasRole(['admin', 'supervisor', 'operator', 'auditor']);
      allow write: if hasRole(['admin', 'supervisor', 'operator']);
    }

    // ── Alerts Collection ──
    match /alerts/{document} {
      allow read: if hasRole(['admin', 'supervisor', 'operator', 'auditor']);
      allow update: if hasRole(['admin', 'supervisor']); // Supervisors acknowledge alerts
      allow create, delete: if false; // Admin SDK only
    }

    // ── Audit Logs Collection ──
    match /audit_logs/{document} {
      allow read: if hasRole(['admin', 'supervisor', 'auditor']);
      allow write: if false; // Admin SDK only (immutable)
    }

    // ── System Configurations Collection ──
    match /systemConfigurations/{document} {
      allow read: if hasRole(['admin', 'supervisor', 'operator']);
      allow write: if hasRole(['admin']); // Admins only edit thresholds
    }

    // ── Users Collection ──
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole(['admin']));
      allow write: if hasRole(['admin']); // Admins create/delete users
    }
  }
}
