{
  "rules": {
    "telemetry": {
      ".read": "auth != null",
      ".write": false
    },
    "relayStates": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'supervisor' || auth.token.role === 'operator')"
    },
    "alerts": {
      ".read": "auth != null",
      "$alertId": {
        ".write": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'supervisor')"
      }
    },
    "audit_logs": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'supervisor' || auth.token.role === 'auditor')",
      ".write": false
    },
    "systemConfigurations": {
      ".read": "auth != null && (auth.token.role === 'admin' || auth.token.role === 'supervisor' || auth.token.role === 'operator')",
      ".write": "auth != null && auth.token.role === 'admin'"
    },
    "users": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || auth.token.role === 'admin' || auth.token.role === 'supervisor')",
        ".write": "auth != null && (auth.uid === $userId || auth.token.role === 'admin')"
      }
    },
    "support_tickets": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
