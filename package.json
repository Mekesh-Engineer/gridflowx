{
  "name": "gridflowx-monorepo",
  "version": "3.0.0",
  "description": "GridFlowX: Smart AI-Driven Microgrid Management and Automation System",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "py -m uvicorn main:app --app-dir backend --reload --port 8000",
    "dev:ai": "py -m uvicorn main:app --app-dir agentic-ai --reload --port 8000",
    "dev:agentic-ai": "py -m uvicorn main:app --app-dir agentic-ai --reload --port 8001",
    "build": "npm run build --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test": "node --test test/unit/*.test.mjs test/integration/*.test.mjs",
    "test:backend": "py test/test_backend_suite.py",
    "test:ai": "py test/test_ai_suite.py",
    "test:router": "py test/test_query_router.py",
    "test:ws": "py test/test_ws.py",
    "test:all": "node --test test/unit/*.test.mjs test/integration/*.test.mjs && py test/test_backend_suite.py && py test/test_ai_suite.py && py test/test_query_router.py && py -m unittest discover -s agentic-ai/tests -p \"test_*.py\" && py -m unittest discover -s backend/tests -p \"test_*.py\"",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,css,json}\"",
    "clean": "rimraf frontend/.next frontend/out frontend/node_modules node_modules"
  },
  "keywords": [
    "microgrid",
    "smart-grid",
    "agentic-ai",
    "ollama-cloud",
    "gemma4",
    "gpt-oss",
    "energy-management",
    "fastapi",
    "nextjs",
    "supabase",
    "postgresql",
    "freertos",
    "esp32"
  ],
  "author": "Platform Architecture & Embedded Systems Research Team",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1"
  }
}
